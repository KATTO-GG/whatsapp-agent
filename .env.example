# WhatsApp Agent Platform API Token
# Get this from: WhatsApp > Settings > Agents > Create Agent > Open Chat > Chat Info > API Key
WHATSAPP_AGENT_API_TOKEN=your_api_token_here

# Your WhatsApp user ID (format: user:1234567890) - enables proactive messaging
# Get this from: WhatsApp > Settings > Agents > Create Agent > Open Chat > Chat Info > User ID
MY_WHATSAPP_USER_ID=user:your_user_id_here